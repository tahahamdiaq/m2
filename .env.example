# ---------------------------------------------------------------------------
# Copier ce fichier vers .env puis adapter les valeurs :  cp .env.example .env
# ---------------------------------------------------------------------------

# Clé secrète Django — générer avec :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# True en dev, False en production
DEBUG=True

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données -------------------------------------------------------
# PostgreSQL (cible) :
DATABASE_URL=postgres://registre:registre@localhost:5432/registre
# Fallback SQLite pour un test rapide sans PostgreSQL :
# DATABASE_URL=sqlite:///db.sqlite3

# --- Emails (SMTP Gmail) ---------------------------------------------------
# En dev, laisser le backend console : les codes s'affichent dans le terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# En prod, activer le vrai SMTP :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Compte Gmail + mot de passe d'application (https://myaccount.google.com/apppasswords)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Registre Controle <no-reply@registre.local>

# Comptes de test : vérification par code court-circuitée (séparés par des virgules)
VERIFICATION_BYPASS_EMAILS=test@gmail.com

# Fuseau horaire
TIME_ZONE=Africa/Casablanca

# Port par défaut de `python manage.py runserver` pour ce projet
RUNSERVER_PORT=8642
